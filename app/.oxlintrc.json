{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc",
    "typescript"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "**/domain/generation/*", "./generation/*"
            ],
            "message": "Level generation has one public API: import from domain/generation, not its files."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/domain/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react-dom",
                  "react/*",
                  "@supabase/*"
                ],
                "message": "domain/ is pure: no React or Supabase."
              },
              {
                "group": [
                  "**/game/**",
                  "**/services/**",
                  "**/screens/**",
                  "**/app/**",
                  "**/ui/**",
                  "**/sprites/**",
                  "**/assets/**",
                  "**/hooks/**"
                ],
                "message": "domain/ is the bottom layer: it imports nothing from the layers above it."
              },
              {
                "group": [
                  "**/domain/generation/*", "./generation/*"
                ],
                "message": "Level generation has one public API: import from domain/generation, not its files."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/domain/**/*.test.ts"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "src/services/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/game/**",
                  "**/screens/**",
                  "**/app/**",
                  "**/ui/**",
                  "**/sprites/**"
                ],
                "message": "services/ must not depend on the UI layers."
              },
              {
                "group": [
                  "**/domain/generation/*", "./generation/*"
                ],
                "message": "Level generation has one public API: import from domain/generation, not its files."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/ui/**",
        "src/sprites/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/game/**",
                  "**/services/**",
                  "**/screens/**",
                  "**/app/**"
                ],
                "message": "ui/ and sprites/ are leaf layers: styles, assets and domain types only."
              },
              {
                "group": [
                  "**/domain/generation/*", "./generation/*"
                ],
                "message": "Level generation has one public API: import from domain/generation, not its files."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/game/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/screens/**",
                  "**/app/**"
                ],
                "message": "game/ must not depend on screens or the app shell."
              },
              {
                "group": [
                  "**/domain/generation/*", "./generation/*"
                ],
                "message": "Level generation has one public API: import from domain/generation, not its files."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/domain/generation/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react-dom",
                  "react/*",
                  "@supabase/*"
                ],
                "message": "domain/ is pure: no React or Supabase."
              },
              {
                "group": [
                  "**/game/**",
                  "**/services/**",
                  "**/screens/**",
                  "**/app/**",
                  "**/ui/**",
                  "**/sprites/**",
                  "**/assets/**",
                  "**/hooks/**"
                ],
                "message": "domain/ is the bottom layer: it imports nothing from the layers above it."
              }
            ]
          }
        ]
      }
    }
  ]
}
